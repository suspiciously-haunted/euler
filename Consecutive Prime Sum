import math

def SOE(limit):
    primes = [True] * (limit + 1)
    primes[0] = primes[1] = False
    
    for i in range(2, int(math.sqrt(limit)) + 1):
        if primes[i]:
            for j in range(i * i, limit + 1, i):
                primes[j] = False
    
    prime_numbers = [i for i in range(limit + 1) if primes[i]]
    return prime_numbers

def find_prime_with_most_consecutive_sums(limit):
    primes = SOE(limit)
    prime_set = set(primes)
    max_consecutive = 0
    prime_with_max_consecutive = 0

    for i in range(len(primes)):
        total = 0
        for j in range(i, len(primes)):
            total += primes[j]
            if total > limit:
                break
            if total in prime_set and (j - i + 1) > max_consecutive:
                max_consecutive = j - i + 1
                prime_with_max_consecutive = total
    
    return prime_with_max_consecutive, max_consecutive

prime, count = find_prime_with_most_consecutive_sums(1000000)
print(prime)

def is_pandigital(m, n, product):
    combined = str(m) + str(n) + str(product)
    return len(combined) == 9 and set(combined) == set('123456789')

def find_pandigital_products():
    products = set() 
    for multiplicand in range(1, 100):
        for multiplier in range(multiplicand, 10000):  
            product = multiplicand * multiplier
            if is_pandigital(multiplicand, multiplier, product):
                products.add(product)
    value = 0
    for i in products:
      value = value + i
    return value

print(find_pandigital_products())

def check_pa(n):
    num = str(n)
    length = len(num)
    for i in range(0, int(length / 2)):
        if num[i] != num[length - i - 1]:
            return False
    return True

total = 0
for i in range(1, 1000000):
    j = bin(i)[2:]
    if check_pa(i) and check_pa(j):
        total += i

print(total)

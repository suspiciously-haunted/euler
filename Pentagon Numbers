def pentagonal(n):
    return n * (3 * n - 1) // 2

def is_pentagonal(x):
    n = (1 + (1 + 24 * x) ** 0.5) / 6
    return n == int(n)

pent_numbers = []
pent_set = set() 

for n in range(1, 10000):
    pent_num = pentagonal(n)
    pent_numbers.append(pent_num)
    pent_set.add(pent_num)

min_diff = float('inf')
min_pair = None

for j in range(len(pent_numbers)):
    for k in range(j + 1, len(pent_numbers)):
        p_j = pent_numbers[j]
        p_k = pent_numbers[k]

        p_sum = p_j + p_k
        p_diff = abs(p_j - p_k)

        if p_sum in pent_set and p_diff in pent_set:
            if p_diff < min_diff:
                min_diff = p_diff
                min_pair = (p_j, p_k)

print(min_diff)

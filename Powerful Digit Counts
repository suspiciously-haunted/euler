import math

def count_nth_powers():
    count = 0
    for n in range(1, 100):
        lower_bound = math.ceil(10 ** ((n - 1) / n))
        upper_bound = 10
        for a in range(lower_bound, upper_bound):
            if len(str(a ** n)) == n:
                count += 1
    return count

print(count_nth_powers())

import math

def pf(n):
    factors = set()
    while n % 2 == 0:
        factors.add(2)
        n //= 2
    
    for i in range(3, int(math.sqrt(n)) + 1, 2):
        while n % i == 0:
            factors.add(i)
            n //= i
    
    if n > 2:
        factors.add(n)
    
    return factors

c = 1
while True:
  if len(pf(c)) == 4 and len(pf(c+1)) == 4 and len(pf(c+2)) == 4 and len(pf(c+3)) == 4: break
  c+=1

print(c)

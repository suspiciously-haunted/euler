from itertools import permutations
def checkprime(n):
    if n%2 == 0: return False
    for i in range(3, int(n**0.5) + 1,2):
        if n % i == 0:
            return False
    return True
primes = []
perms = [''.join(p) for p in permutations('1234567')]
for p in perms:
    if checkprime(int(p)):
      primes.append(p)
print(max(primes))
